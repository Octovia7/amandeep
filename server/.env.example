NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/todo_app

# Generate strong values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed frontend origins (CORS + reset links)
CLIENT_ORIGINS=http://localhost:5173

# Fraction of the SLA window remaining at which a task becomes "At Risk" (0.2 = 20%)
SLA_AT_RISK_THRESHOLD=0.2
RESET_TOKEN_TTL_MINUTES=30

# Optional: database used by `npm test` (defaults to a throwaway todo_test_<timestamp> DB that is dropped afterwards)
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/todo_test
